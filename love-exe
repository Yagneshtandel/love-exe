<!DOCTYPE html>  <html lang="en">  
<head>  
<meta charset="UTF-8">  
<meta name="viewport" content="width=device-width, initial-scale=1.0">  
<title>Love.exe 🦋</title>  <style>  
* {  
  margin: 0;  
  padding: 0;  
  box-sizing: border-box;  
}  
  
body {  
  background: radial-gradient(ellipse at center, #17223c, #03020a 80%);  
  height: 100vh;  
  overflow: hidden;  
  display: flex;  
  justify-content: center;  
  align-items: center;  
}  
  
#scene {  
  position: relative;  
  width: 100%;  
  height: 100%;  
  overflow: hidden;  
}  
  
.butterfly {  
  position: absolute;  
  color: #ff16b9;  
  text-shadow: 0 0 8px #ff00ae, 0 0 20px #ff008c;  
  animation: fly linear infinite;  
  user-select: none;  
}  
  
@keyframes fly {  
  0% {  
    transform: translate(0, 100px) rotate(0deg) scale(.6);  
    opacity: 0;  
  }  
  15% { opacity: 1; }  
  50% {  
    transform: translate(30px, -40px) rotate(20deg) scale(1.1);  
  }  
  85% { opacity: 1; }  
  100% {  
    transform: translate(-30px, -130vh) rotate(-20deg) scale(.7);  
    opacity: 0;  
  }  
}  
  
.heart {  
  position: absolute;  
  left: 50%;  
  top: 48%;  
  transform: translate(-50%, -50%);  
  width: min(75vw, 350px);  
  height: min(75vw, 350px);  
}  
  
.heart-butterfly {  
  position: absolute;  
  transform: translate(-50%, -50%);  
  color: #ff20c4;  
  text-shadow: 0 0 6px #ff00b7, 0 0 14px #ff008c;  
  animation: pulse 1.5s ease-in-out infinite alternate;  
}  
  
@keyframes pulse {  
  from {  
    opacity: .65;  
    filter: brightness(.8);  
  }  
  to {  
    opacity: 1;  
    filter: brightness(1.8);  
  }  
}  
  
.caption {  
  position: absolute;  
  bottom: 7%;  
  width: 100%;  
  text-align: center;  
  color: #ff6ad5;  
  font: 14px monospace;  
  letter-spacing: 4px;  
  text-shadow: 0 0 12px #ff00b7;  
}  
</style>  </head>  <body>  
<div id="scene">  
  <div class="heart" id="heart"></div>  
  <div class="caption">LOVE.EXE ❤️</div>  
</div>  <script>  
const scene = document.getElementById("scene");  
const heart = document.getElementById("heart");  
  
// Flying butterflies  
for (let i = 0; i < 55; i++) {  
  const b = document.createElement("div");  
  b.className = "butterfly";  
  b.textContent = "🦋";  
  
  b.style.left = Math.random() * 100 + "%";  
  b.style.top = (40 + Math.random() * 100) + "%";  
  b.style.fontSize = (12 + Math.random() * 24) + "px";  
  b.style.animationDuration = (7 + Math.random() * 12) + "s";  
  b.style.animationDelay = (-Math.random() * 15) + "s";  
  
  // Pink glow instead of the emoji's natural colors  
  b.style.filter = "grayscale(1) sepia(1) saturate(8) hue-rotate(270deg)";  
  scene.appendChild(b);  
}  
  
// Butterfly heart pattern  
const count = 150;  
  
for (let i = 0; i < count; i++) {  
  const t = Math.PI * 2 * i / count;  
  
  // Heart curve  
  const x = 16 * Math.pow(Math.sin(t), 3);  
  const y = -(13 * Math.cos(t) - 5 * Math.cos(2*t)  
            - 2 * Math.cos(3*t) - Math.cos(4*t));  
  
  const b = document.createElement("span");  
  b.className = "heart-butterfly";  
  b.textContent = "🦋";  
  
  b.style.left = (50 + x * 2.1) + "%";  
  b.style.top = (50 + y * 2.1) + "%";  
  b.style.fontSize = (8 + Math.random() * 9) + "px";  
  b.style.animationDelay = Math.random() * 2 + "s";  
  
  heart.appendChild(b);  
}  
</script>  </body>  
</html> 
